{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NBA Tracker",
  "version": "0.1.0",
  "identifier": "org.vellum.nbatracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "NBA Tracker",
        "width": 380,
        "height": 560,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": true,
        "alwaysOnTop": false,
        "center": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright 2026 Occiderunt",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "opener": {}
  }
}
